<?xml version="1.0" encoding="utf-8"?>

<!-- 
 AndroidManifest.xml

 Declares required permissions and registers the AccessibilityService used to detect when Tiktok becomes
 the foreground app.
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
    Allows the app to draw system-level overlays above other apps
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 
    Used to query recent app usage as a fallback for foreground app detection.
    Primary detection is handled in real time by AccessibilityService. Ignore warnings due to "PACKAGE_USAGE_STATS"
    being a protected permission
    -->
    <uses-permission 
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollGuard">

        <!-- 
        Accessibility service is responsible for detecting when Tiktok is opened or closed"
        -->

        <service
            android:name=".AppMonitorService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <!-- 
            accessibility service configuration
            -->

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        


        </service> 

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScrollGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>